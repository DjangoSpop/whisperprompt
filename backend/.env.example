# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For local development, leave empty to use SQLite
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_whisperer
DATABASE_URL=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# OpenAI API Key (Required for Whisper transcription)
OPENAI_API_KEY=your-openai-api-key-here

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage (Optional - for production)
USE_S3=False
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# Session Limits
FREE_TIER_MONTHLY_SESSIONS=50
PRO_TIER_MONTHLY_SESSIONS=500

# Logging
DJANGO_LOG_LEVEL=INFO
